# ==========================================
# EduFlow - Environment Variables Configuration
# ==========================================

# Base de Données MySQL (Prisma ORM)
DATABASE_URL="mysql://root:root@localhost:3306/eduflow"

# Clé secrète JWT pour l'authentification
JWT_SECRET="votre-cle-secrete-jwt-tres-longue-et-aleatoire-min-32-chars"

# Google Gemini API Key (Server Only - OCR, Chat Pédagogique, Quiz & Résumé)
GEMINI_API_KEY="votre-cle-gemini-api"

# URL de l'Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Serveur SMTP (Nodemailer) pour l'envoi des codes de connexion par e-mail (OTP à 6 chiffres)
# Exemple Gmail : SMTP_HOST="smtp.gmail.com", SMTP_PORT="587", SMTP_PASS="votre-mot-de-passe-d-application"
SMTP_HOST="votre-serveur-smtp"
SMTP_PORT="587"
SMTP_USER="votre-adresse-email@gmail.com"
SMTP_PASS="votre-mot-de-passe-application-smtp"
SMTP_FROM="\"EduFlow Académique\" <votre-adresse-email@gmail.com>"

# (Optionnel - Legacy) Supabase si certaines fonctions cloud sont conservées
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
